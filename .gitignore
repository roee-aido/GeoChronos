# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
.env.*

# --- Local backups (restore points; not part of the project history) ---
backups/

# --- HTTP cache (regenerable; not provenance) ---
data/cache/

# --- OpenAlex raw responses: contain researcher e-mail addresses and
# publisher abstracts. Kept locally only; nothing in scripts/ or tests/ reads them,
# and data/seed/literature.json keeps the citations. ---
data/raw/openalex/

# --- Build outputs (regenerable with scripts/build_db.py) ---
# Keep only the 2026-10-01 night-run reports that README/HANDOFF link to;
# ignore databases, build reports and per-run stdout/stderr logs.
build/*
!build/runs/
build/runs/*
!build/runs/2026-10-01_night/
build/runs/2026-10-01_night/*/
# Internal working notes from the night run (kept locally, not published)
build/runs/2026-10-01_night/HANDOFF.md
build/runs/2026-10-01_night/NIGHT_REPORT.md
build/runs/2026-10-01_night/SPEC_INPUTS.md
*.sqlite
*.sqlite-journal

# --- Personal working documents (planning with other tools; not project source) ---
Context/
GeoChronos-spec.draft*.md
Claude-GeoChronos-*.md
TRANs-GeoChronos.md

